# ───────────── HAKILI — Manden Digital SARL ─────────────
# Copier vers .env et compléter. NE JAMAIS committer de vraie clé.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000        # prod : https://hakili.mandendigital.com
SESSION_MAX_AGE_DAYS=14
TRIAL_DAYS=14
MAX_UPLOAD_MB=15

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_POOL_MAX=10
# VECTOR_BACKEND=native | pgvector  (pgvector : voir scripts/enable-pgvector.sql)
VECTOR_BACKEND=native

# Fournisseur IA (aucune clé => mode local extractif de démonstration)
# AI_PROVIDER = auto | openai | gemini | muapi | local
AI_PROVIDER=auto
# EMBEDDING_PROVIDER = auto | openai | gemini | local
EMBEDDING_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536
# OPENAI_BASE_URL=https://api.openai.com/v1   # compatible : modèle auto-hébergé (vLLM, Ollama, LM Studio)

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

MUAPI_API_KEY=
MUAPI_MODEL=google/gemini-2.5-flash

# Stockage des fichiers originaux : local | s3 (Supabase Storage / MinIO / AWS)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=            # ex. https://xxxx.supabase.co/storage/v1
S3_BUCKET=hakili
S3_BEARER_TOKEN=        # clé service (côté serveur uniquement)

# Amorçage du super administrateur (npm run seed)
SUPERADMIN_EMAIL=admin@mandendigital.com
SUPERADMIN_PASSWORD=changeme-mot-de-passe-fort
SUPERADMIN_NAME=Administrateur Manden Digital
SEED_DEMO=true          # false en production

# Paiements mobiles (V2 — non requis pour le MVP)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
MOOV_MONEY_API_KEY=

# Sécurité : origines autorisées à embarquer l'application en iframe (CSP frame-ancestors).
# * par défaut (aperçu). En production : 'self' https://hakili.mandendigital.com
# (le widget /widget/* reste intégrable sur tous les sites clients)
FRAME_ANCESTORS=*

# Rate limiting partagé (optionnel en local, recommandé en production)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
